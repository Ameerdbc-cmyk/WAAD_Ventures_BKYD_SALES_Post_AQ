//SQL

ALTER TABLE "BKYD Sales Post-acquisition(All Data) (1)" 
RENAME TO bkyd_sales;

// Sanity check

SELECT Period, COUNT(*) as row_count
FROM bkyd_sales
WHERE "Row Type" = 'Item'
GROUP BY Period;

SELECT Period, ROUND(SUM("Gross Sales"), 2) as total_revenue
FROM bkyd_sales
WHERE "Row Type" = 'Item'
GROUP BY Period;

// Filter out Feb due to negligible data

CREATE VIEW mar_apr AS
SELECT * FROM bkyd_sales
WHERE "Row Type" = 'Item'
AND Period != 'FEB';

// Category revenue by period

SELECT 
    Period,
    Category,
    SUM(Sold) as total_units,
    ROUND(SUM("Gross Sales"), 2) as total_revenue
FROM mar_apr
GROUP BY Period, Category
ORDER BY Period, total_revenue DESC;

// Side by side pivot to see march and april together

SELECT
    Category,
    ROUND(SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END), 2) as mar_revenue,
    ROUND(SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END), 2) as apr_revenue,
    ROUND(SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END) - 
          SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END), 2) as change_dollars,
    ROUND((SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END) - 
           SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END)) / 
           SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END) * 100, 1) as change_pct
FROM mar_apr
GROUP BY Category
ORDER BY mar_revenue DESC;


// Item-level RANKING

SELECT
    Period,
    Category,
    Item,
    SUM(Sold) as total_units,
    ROUND(SUM("Gross Sales"), 2) as total_revenue,
    RANK() OVER (PARTITION BY Period, Category ORDER BY SUM("Gross Sales") DESC) as rank_in_category
FROM mar_apr
GROUP BY Period, Category, Item
ORDER BY Period, Category, rank_in_category;


// Item level comparison SOLD

SELECT
    Category,
    Item,
    ROUND(SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END), 2) as mar_revenue,
    ROUND(SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END), 2) as apr_revenue,
    ROUND(SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END) -
          SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END), 2) as change_dollars,
    ROUND((SUM(CASE WHEN Period = 'APR' THEN "Gross Sales" END) -
           SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END)) /
           SUM(CASE WHEN Period = 'MAR' THEN "Gross Sales" END) * 100, 1) as change_pct,
    SUM(CASE WHEN Period = 'MAR' THEN Sold END) as mar_units,
    SUM(CASE WHEN Period = 'APR' THEN Sold END) as apr_units
FROM mar_apr
GROUP BY Category, Item
ORDER BY change_dollars ASC;

// Underperformers

SELECT
    Category,
    Item,
    SUM(Sold) as total_units,
    ROUND(SUM("Gross Sales"), 2) as total_revenue
FROM mar_apr
WHERE Period = 'APR'
GROUP BY Category, Item
HAVING total_units < 20
ORDER BY total_units ASC;


// Pareto Analysis

SELECT
    Item,
    ROUND(SUM("Gross Sales"), 2) as total_revenue,
    ROUND(SUM(SUM("Gross Sales")) OVER (ORDER BY SUM("Gross Sales") DESC), 2) as running_total,
    ROUND(SUM(SUM("Gross Sales")) OVER (ORDER BY SUM("Gross Sales") DESC) / 
          SUM(SUM("Gross Sales")) OVER () * 100, 1) as cumulative_pct
FROM mar_apr
WHERE Period = 'APR'
GROUP BY Item
ORDER BY total_revenue DESC;



// Modifier revenue by period

SELECT
    Period,
    ROUND(SUM("Modifier Gross Sale"), 2) as modifier_revenue,
    ROUND(SUM("Gross Sales"), 2) as total_revenue,
    ROUND(SUM("Modifier Gross Sale") / SUM("Gross Sales") * 100, 2) as modifier_pct
FROM mar_apr
GROUP BY Period;

// Revenue per unit by item

SELECT
    Period,
    Category,
    Item,
    SUM(Sold) as total_units,
    ROUND(SUM("Gross Sales"), 2) as total_revenue,
    ROUND(SUM("Gross Sales") / SUM(Sold), 2) as revenue_per_unit
FROM mar_apr
WHERE Sold > 0
GROUP BY Period, Category, Item
ORDER BY Period, revenue_per_unit DESC;
